#!/bin/busybox sh
# Dash OS -- one supervised USB setup attempt. Storage stays in diagnostics.
# Never force an OTG role through /proc/asession: the stock gadget path binds it.
PATH=/bin:/sbin
export PATH
LOG=/var/log/dash.log
case "$#:$*" in
	0:) exec /bin/usb-supervise >>"$LOG" 2>&1 ;;
	1:setup) ;;
	*) printf 'usage: 20-usbnet/run [setup]\n' >&2; exit 2 ;;
esac

# The supervisor captures every worker diagnostic, signal, and whole-setup timeout.
MODULES=/lib/modules/3.0.35-lab126
DRIVERS=/sys/bus/platform/drivers
FAILED=/var/run/dash-usbnet-failed
STATUS=/var/run/dash-usbnet-worker.status
status() {
	# A timed-out kernel call may resume later; never let that worker advance.
	[ ! -e "$FAILED" ] && [ ! -L "$FAILED" ] || return 1
	printf '%s\n%s\n' "$1" "$2" >"$STATUS.new" && mv "$STATUS.new" "$STATUS"
}
say() {
	echo "$(cut -d. -f1 /proc/uptime 2>/dev/null)s  20-usbnet: $*" >>"$LOG"
}
fail() {
	say "unavailable: $*"
	status failed "$*" || say "could not publish worker status"
	exit 1
}
uptime_s() {
	read -r up rest </proc/uptime || return 1
	up=${up%%.*}
	case "$up" in ''|*[!0-9]*) return 1 ;; esac
	printf '%s\n' "$up"
}
load() {
	module=$1
	shift
	status starting "loading $module" || fail "could not publish worker status"
	if grep -q "^$module " /proc/modules; then
		say "$module already loaded"
		return
	fi
	[ -f "$MODULES/$module.ko" ] && [ ! -L "$MODULES/$module.ko" ] \
		|| fail "missing or unsafe module $module"
	say "loading $module"
	insmod "$MODULES/$module.ko" "$@" || fail "loading $module failed"
	grep -q "^$module " /proc/modules || fail "$module did not register"
}
bound() {
	driver=$1
	status starting "checking $driver binding" || fail "could not publish worker status"
	[ -d "$DRIVERS/$driver" ] || fail "$driver did not register"
	driver_path=$(readlink -f "$DRIVERS/$driver") || fail "cannot inspect $driver"
	# sysfs module/subsystem links alone do not prove a successful device probe.
	for device in "$DRIVERS/$driver"/*; do
		[ -L "$device" ] && [ -d "$device" ] && [ -L "$device/driver" ] || continue
		binding=$(readlink -f "$device/driver") || continue
		if [ "$binding" = "$driver_path" ]; then
			say "$driver bound to ${device##*/}"
			return
		fi
	done
	fail "$driver has no bound device"
}

status starting "checking gadget modules" || fail "could not publish worker status"
[ "$(uname -r)" = 3.0.35-lab126 ] || fail "kernel release does not match modules"
[ -r /proc/modules ] || fail "cannot inspect loaded modules"
for gadget in g_file_storage g_serial g_multi g_mass_storage g_cdc; do
	grep -q "^$gadget " /proc/modules && fail "competing gadget $gadget is loaded"
done
load fsl_otg_arc
bound fsl-usb2-otg
load arcotg_udc
bound fsl-usb2-udc
load g_ether use_eem=0 host_addr=02:00:00:00:00:01 dev_addr=02:00:00:00:00:02

status starting "waiting for usb0" || fail "could not publish worker status"
start=$(uptime_s) || fail "no uptime clock for USB readiness"
deadline=$((start + 5))
polls=0
while [ ! -d /sys/class/net/usb0 ]; do
	now=$(uptime_s) || fail "lost uptime clock"
	[ "$now" -lt "$deadline" ] && [ "$polls" -lt 10000 ] \
		|| fail "usb0 did not appear"
	polls=$((polls + 1))
done
status starting "configuring usb0" || fail "could not publish worker status"
say "configuring usb0 as 192.168.15.244/24 (no default route)"
ip addr replace 192.168.15.244/24 dev usb0 || fail "setting USB address failed"
ip link set dev usb0 up || fail "bringing usb0 up failed"
address=$(ip -4 addr show dev usb0) || fail "reading USB address failed"
printf '%s\n' "$address" | grep -q 'inet 192\.168\.15\.244/24 ' \
	|| fail "USB address verification failed"
link=$(ip link show dev usb0) || fail "reading USB link failed"
printf '%s\n' "$link" | grep -qE '<([^>]*,)?UP(,|>)' \
	|| fail "USB link verification failed"
# Only the supervisor publishes readiness after this worker exits successfully.
status starting "setup complete" || fail "could not publish worker status"
say "setup complete; waiting for supervisor verification"
exit 0
