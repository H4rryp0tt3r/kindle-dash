#!/bin/busybox sh
# Dash OS -- USB Ethernet maintenance link. Storage stays in diagnostics.
# Keep the gadget loaded when SSH restarts; the panel service is independent.
PATH=/bin:/sbin
export PATH
LOG=/var/log/dash.log
MODULES=/lib/modules/3.0.35-lab126
READY=/var/run/dash-usbnet-ready
FAILED=/var/run/dash-usbnet-failed

say() {
	echo "$(cut -d. -f1 /proc/uptime 2>/dev/null)s  20-usbnet: $*" >>"$LOG"
}
park() {
	exec tail -f /dev/null 2>/dev/null
}
fail() {
	say "unavailable: $*"
	rm -f "$READY"
	printf '%s\n' "$*" >"$FAILED"
	dmesg >>"$LOG" 2>&1
	park
}
uptime_s() {
	read -r up rest </proc/uptime || return 1
	printf '%s\n' "${up%%.*}"
}
load() {
	module=$1
	shift
	if grep -q "^$module " /proc/modules; then
		say "$module already loaded"
		return
	fi
	[ -f "$MODULES/$module.ko" ] && [ ! -L "$MODULES/$module.ko" ] \
		|| fail "missing module $module"
	say "loading $module"
	insmod "$MODULES/$module.ko" "$@" >>"$LOG" 2>&1 \
		|| fail "loading $module failed"
}

rm -f "$READY" "$FAILED"
[ "$(uname -r)" = 3.0.35-lab126 ] || fail "kernel release does not match modules"
load fsl_otg_arc
# The verified lab126 interface selects peripheral mode with 0, NOT 1 (host).
if [ -e /proc/asession ]; then
	say "selecting USB peripheral mode (/proc/asession=0)"
	printf '0\n' >/proc/asession || fail "could not select peripheral mode"
fi
load arcotg_udc
load g_ether host_addr=02:00:00:00:00:01 dev_addr=02:00:00:00:00:02

start=$(uptime_s) || fail "no uptime clock for USB readiness"
deadline=$((start + 10))
polls=0
while [ ! -d /sys/class/net/usb0 ]; do
	now=$(uptime_s) || fail "lost uptime clock"
	[ "$now" -lt "$deadline" ] && [ "$polls" -lt 10000 ] \
		|| fail "usb0 did not appear"
	polls=$((polls + 1))
done
say "configuring usb0 as 192.168.15.244/24 (no default route)"
ip addr replace 192.168.15.244/24 dev usb0 >>"$LOG" 2>&1 \
	|| fail "setting USB address failed"
ip link set dev usb0 up >>"$LOG" 2>&1 || fail "bringing usb0 up failed"
ip -4 addr show dev usb0 | grep -q 'inet 192\.168\.15\.244/24 ' \
	|| fail "USB address verification failed"
printf '192.168.15.244/24\n' >"$READY" || fail "could not record readiness"
say "ready; Mac USB Ethernet address is 192.168.15.201/24"
park
