#!/bin/busybox sh
# Dash OS -- the only panel owner. Stream current-boot logs and setup status.
# The coordinator blocks while idle, coalesces output during a refresh, and uses
# one conservative GC16 update per frame. USB/SSH never touch the framebuffer.
PATH=/bin:/sbin
export PATH
LOG=/var/log/dash.log
printf '%ss  10-dash: starting streaming panel\n' "$(cut -d. -f1 /proc/uptime)" >>"$LOG"
# Exec keeps runit's stop/restart directed at the coordinator, not a shell that
# could leave an orphan renderer competing with the next service instance.
exec /bin/dash-status >>"$LOG" 2>&1
