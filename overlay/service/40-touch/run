#!/bin/busybox sh
# Dash OS -- one bounded Cypress touch setup per boot; never a retry loop.
# The supervisor (no arguments) is the only writer of the public status. The
# worker (setup) does every kernel-facing step in its own session. On a deadline
# the worker is SIGKILLed and latched off, but no signal can abort a module init
# that is already running in the kernel: that call may still finish. The latch
# guarantees only no further userspace step, no second worker and no late
# readiness. Never loads cyttsp4_loader (firmware), debug or device_access.
PATH=/bin:/sbin
export PATH
LOG=/var/log/dash.log
RUN=/var/run
STATUS=$RUN/dash-touch.status
FAILED=$RUN/dash-touch-failed
ATTEMPT=$RUN/dash-touch-attempt
STAGE=$ATTEMPT/stage
DONE=$ATTEMPT/done
MODULES=/lib/modules/3.0.35-lab126
DEADLINE=20
# Only the PINOT_WFO (027) board type has been proven with these modules.
BOARD=027
# Raw stock module bytes; the build pins the same files.
I2C_SHA=e87420682b3bed0a33f4227bf989c183f9c667fa570993198a44fd7f93f60007
CORE_SHA=2ed8d905b5db121fb0161a860ffe96907e285b91097e40b3eaf0160dab439e40
MT_SHA=5ea8cd50683dde58c7843c057e8f2c415e51f263a4259bd5c1e71efe86b9c09a

say() {
	echo "$(cut -d. -f1 /proc/uptime 2>/dev/null)s  40-touch: $*" >>"$LOG"
}
uptime_s() {
	read -r up rest </proc/uptime || return 1
	up=${up%%.*}
	case "$up" in ''|*[!0-9]*) return 1 ;; esac
	printf '%s\n' "$up"
}

# ------------------------------------------------------------------ worker
latched() {
	[ -e "$FAILED" ] || [ -L "$FAILED" ]
}
stage() {
	# A timed-out worker that resumes stops here, before any further step.
	latched && exit 1
	printf '%s\n' "$1" >"$STAGE.new" && mv "$STAGE.new" "$STAGE" || exit 1
}
fail() {
	say "unavailable: $*"
	latched || { printf 'failed: %s\n' "$*" >"$STAGE.new" && mv "$STAGE.new" "$STAGE"; }
	exit 1
}
loaded() {
	grep -q "^$1 " /proc/modules
}
pinned() {
	file=$MODULES/$1.ko
	[ -f "$file" ] && [ ! -L "$file" ] || fail "missing or unsafe module $1"
	sum=$(sha256sum "$file") || fail "cannot hash module $1"
	[ "${sum%% *}" = "$2" ] || fail "module $1 does not match its pinned hash"
}
no_competitors() {
	for module in cyttsp4_loader cyttsp4_debug cyttsp4_device_access; do
		loaded "$module" && fail "competing module $module is loaded"
	done
	grep -q '^zforce' /proc/modules && fail "competing zforce module is loaded"
	return 0
}
recovery_off() {
	# required: a preloaded core must prove recovery_mode=0 or setup stops.
	param=/sys/module/cyttsp4_core/parameters/recovery_mode
	if [ -e "$param" ] || [ "$1" = required ]; then
		read -r mode <"$param" 2>/dev/null || fail "cannot verify cyttsp4_core recovery_mode"
		case "$mode" in 0|N) ;; *) fail "cyttsp4_core recovery_mode is enabled ($mode)" ;; esac
	fi
}
load() {
	module=$1
	shift
	stage "loading $module"
	if loaded "$module"; then
		say "$module already loaded"
		return
	fi
	say "loading $module $*"
	insmod "$MODULES/$module.ko" "$@" || fail "loading $module failed"
	loaded "$module" || fail "$module did not register"
}
bound() {
	dir=/sys/bus/$1/drivers/$2
	stage "checking $2 binding"
	[ -d "$dir" ] || fail "$2 driver did not register"
	driver_path=$(readlink -f "$dir") || fail "cannot inspect $2"
	# Module or subsystem links alone do not prove a successful device probe.
	for device in "$dir"/*; do
		[ -L "$device" ] && [ -d "$device" ] && [ -L "$device/driver" ] || continue
		binding=$(readlink -f "$device/driver") || continue
		if [ "$binding" = "$driver_path" ]; then
			say "$2 bound to ${device##*/}"
			return
		fi
	done
	fail "$2 has no bound device"
}
find_input() {
	# Discover by input name; the event number is not stable across boots.
	found=
	for name in /sys/class/input/event*/device/name; do
		[ -f "$name" ] || continue
		read -r value <"$name" 2>/dev/null || continue
		[ "$value" = cyttsp4_mt ] || continue
		[ -z "$found" ] || fail "multiple cyttsp4_mt input devices"
		found=${name#/sys/class/input/}
		found=${found%%/*}
	done
	case "${found#event}" in ''|*[!0-9]*) return 1 ;; esac
	[ -c "/dev/input/$found" ]
}
worker() {
	stage "checking platform"
	[ "$(uname -r)" = 3.0.35-lab126 ] || fail "kernel release does not match modules"
	board=$(cat /proc/board_id 2>/dev/null) || fail "cannot read board id"
	case "$board" in
		"$BOARD"*) ;;
		*) fail "board type ${board%"${board#???}"} is not the proven $BOARD board" ;;
	esac
	[ -r /proc/modules ] || fail "cannot inspect loaded modules"
	no_competitors
	stage "verifying pinned modules"
	pinned cyttsp4_i2c "$I2C_SHA"
	pinned cyttsp4_core "$CORE_SHA"
	pinned cyttsp4_mt_b "$MT_SHA"
	! loaded cyttsp4_core || recovery_off required

	load cyttsp4_i2c
	bound i2c cyttsp4_i2c_adapter
	load cyttsp4_core recovery_mode=0
	recovery_off required
	bound ttsp4 cyttsp4_core
	load cyttsp4_mt_b
	bound ttsp4 cyttsp4_mt

	stage "waiting for cyttsp4_mt input"
	start=$(uptime_s) || fail "no uptime clock for input readiness"
	limit=$((start + 10))
	polls=0
	until find_input; do
		now=$(uptime_s) || fail "lost uptime clock"
		[ "$now" -lt "$limit" ] && [ "$polls" -lt 100000 ] \
			|| fail "cyttsp4_mt input did not appear"
		polls=$((polls + 1))
	done
	no_competitors
	recovery_off required
	stage "complete /dev/input/$found"
	say "setup complete: cyttsp4_mt at /dev/input/$found; awaiting supervisor"
	exit 0
}

# -------------------------------------------------------------- supervisor
publish() {
	printf '%s\n%s\n' "$1" "$2" >"$STATUS.new" && mv "$STATUS.new" "$STATUS"
}
park() {
	exec 3>&-
	exec tail -f /dev/null 2>/dev/null
}
current_stage() {
	text=
	read -r text <"$STAGE" 2>/dev/null
	printf '%s\n' "${text:-unknown stage}"
}
terminal() {
	trap - TERM INT HUP
	: >"$FAILED" || say "could not latch failure"
	publish failed "$*" || say "could not publish status"
	say "unavailable: $*"
	say "kernel diagnostics follow (last 40 lines)"
	timeout -s KILL 2 /bin/busybox sh -c 'dmesg | tail -n 40' >>"$LOG" 2>&1
	park
}
stopped() {
	# Stopping mid-attempt is terminal for this boot as well.
	trap - TERM INT HUP
	: >"$FAILED"
	[ -z "$worker" ] || kill -KILL "-$worker" "$worker" 2>/dev/null
	publish failed "service stopped during setup; no retry" || say "could not publish status"
	say "stopped during setup; no retry this boot"
	exit 0
}
supervise() {
	if ! mkdir -m 700 "$ATTEMPT" 2>/dev/null; then
		# Never a second worker this boot, even if an earlier one is still alive.
		phase=
		read -r phase <"$STATUS" 2>/dev/null
		case "$phase" in
			ready|failed) say "setup already attempted this boot; keeping $phase status" ;;
			*)
				: >"$FAILED"
				publish failed "setup already attempted this boot; no retry" \
					|| say "could not publish status"
				say "unavailable: setup already attempted this boot; no retry"
				;;
		esac
		park
	fi
	worker=
	trap stopped TERM INT HUP
	publish starting "launching setup worker" || terminal "could not publish status"
	mkfifo -m 600 "$DONE" && exec 3<>"$DONE" || terminal "cannot create worker channel"
	say "one setup attempt; ${DEADLINE}s deadline; no retry"
	# Only this wrapper writes the result; the worker itself gets no handle to it.
	setsid /bin/busybox sh -c '/bin/busybox sh /service/40-touch/run setup 3>&-; echo "exit $?" >&3' \
		</dev/null >>"$LOG" 2>&1 &
	worker=$!
	result=
	# A bounded wait on the result channel: no sleep, no spin.
	read -t "$DEADLINE" -r result <&3 || result=timeout
	case "$result" in
		"exit 0") ;;
		timeout)
			# Latch before killing, so a worker resuming in between cannot advance.
			: >"$FAILED"
			kill -KILL "-$worker" "$worker" 2>/dev/null
			terminal "setup deadline exceeded during: $(current_stage); no retry"
			;;
		"exit "*)
			wait "$worker" 2>/dev/null
			stage=$(current_stage)
			terminal "${stage#failed: }"
			;;
		*) terminal "invalid worker result" ;;
	esac
	wait "$worker" 2>/dev/null
	stage=$(current_stage)
	case "$stage" in
		"complete /dev/input/event"*) ;;
		*) terminal "worker exited without verified completion" ;;
	esac
	path=${stage#complete }
	case "${path#/dev/input/event}" in
		''|*[!0-9]*) terminal "worker reported an invalid input path" ;;
	esac
	[ -c "$path" ] || terminal "input device $path is missing"
	trap - TERM INT HUP
	publish ready "$path" || terminal "could not publish readiness"
	say "ready: cyttsp4_mt at $path"
	park
}

case "$#:$*" in
	0:) supervise ;;
	1:setup) worker ;;
	*) printf 'usage: 40-touch/run [setup]\n' >&2; exit 2 ;;
esac
